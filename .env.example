# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (required) ---
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth (required — no hardcoded fallback exists; admin login is disabled without these) ---
# Random session secret (min 32 chars). Used to sign admin session + OTP cookies.
# Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Salted password hash, format "<hex salt>:<hex scrypt-derived key>". Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],Buffer.from(s,'hex'),64).toString('hex'))" 'your-new-password'
ADMIN_PASSWORD_HASH=

# --- Email (Resend) ---
# Used for admin OTP, security alerts, and contact form auto-replies.
# Without this, OTP codes are only printed in the server console.
RESEND_API_KEY=
